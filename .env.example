# Copy to .env.local. Never commit credentials.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
# Optional paid photoreal concept generation, grounded in Blender geometry.
OPENAI_IMAGE_MODEL=gpt-image-2
# Optional hackathon-compatible API endpoint, only if supplied by organizers.
# OPENAI_BASE_URL=https://api.openai.com/v1
# Set to 1 for a fully deterministic, visibly labeled demo without API calls.
DREAMBID_DEMO_MODE=0
# macOS standard install. Linux users can use /usr/bin/blender.
BLENDER_PATH=/Applications/Blender.app/Contents/MacOS/Blender
BLENDER_TIMEOUT_MS=60000
# Public Census + USDA NAIP context works without a Maps key (coverage varies).
DREAMBID_PROPERTY_PROVIDER=public
# Optional Google display-only context. Use a server key, not an HTTP-referrer key.
# Set DREAMBID_PROPERTY_PROVIDER=google to enable; APIs: Geocoding, Street View Static, Maps Static.
GOOGLE_MAPS_API_KEY=
# Optional stable secret for imagery proxy URLs; otherwise uses an existing server API key.
PROPERTY_CONTEXT_SIGNING_KEY=
